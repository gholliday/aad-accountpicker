{
  "name": "AAD Account Picker",
  "version": "0.4",
  "description": "Auto-selects your account on Microsoft login pages based on your Edge profile.",
  "manifest_version": 3,
  "permissions": [
    "identity",
    "identity.email",
    "storage"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://github.com/enterprises/*/sso*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AAD Account Picker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://login.microsoftonline.com/*/oauth2/authorize*",
        "https://login.microsoftonline.com/*/oauth2/v2.0/authorize*",
        "https://login.microsoftonline.com/*/saml2*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://github.com/enterprises/*/sso*"
      ],
      "js": ["githubSsoScript.js"],
      "run_at": "document_end"
    }
  ]
}
